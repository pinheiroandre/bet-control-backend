# Porta em que o servidor vai rodar localmente
PORT=

# String de conexão com o banco PostgreSQL.
# Por enquanto local, via Docker (veja docker-compose.yml). Depois trocamos pela URL do Neon.
DATABASE_URL=""

# Dados da aplicação criada no Auth0 (painel do Auth0 > Applications).
# Deixe em branco por enquanto — configuramos isso mais tarde.
AUTH0_DOMAIN=""
AUTH0_AUDIENCE=""
