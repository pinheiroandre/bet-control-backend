// Este arquivo define a conexão com o banco e (futuramente) os modelos de dados.
// A modelagem real dos "lançamentos" será feita depois, junto com você.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Modelo de exemplo, só para validar que a conexão com o banco funciona.
model Status {
  id        Int      @id @default(autoincrement())
  message   String
  createdAt DateTime @default(now())
}

// Represents a bookmaker (betting house) — e.g. Bet365, Betano, etc.
// The current balance is NOT stored here: it is always calculated by summing
// initialBalance with the related bet entries (income and expenses).
model Bookmaker {
  id                 Int      @id @default(autoincrement())
  description        String
  initialBalance     Decimal  @default(0) @db.Decimal(10, 2) @map("initial_balance")
  initialBalanceDate DateTime @map("initial_balance_date") @db.Date
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("bookmaker")
}

model Tipster {
  id                 Int      @id @default(autoincrement())
  name               String
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("tipster")
}
