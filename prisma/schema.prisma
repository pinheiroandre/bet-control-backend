// Este arquivo define a conexão com o banco e (futuramente) os modelos de dados.
// A modelagem real dos "lançamentos" será feita depois, junto com você.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Bookmaker {
  id                 String   @id @default(uuid()) @db.Uuid
  description        String
  initialBalance     Decimal  @default(0) @db.Decimal(10, 2) @map("initial_balance")
  initialBalanceDate DateTime @map("initial_balance_date") @db.Date
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  bets Bet[]

  @@map("bookmaker")
}

model Tipster {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  bets Bet[]

  @@map("tipster")
}

enum BetStatus {
  PENDING
  WON
  LOST
  VOID
  CASHED_OUT
  HALF_WON
  HALF_LOST

  @@map("bet_status")
}

model Bet {
  id            String    @id @default(uuid()) @db.Uuid
  description   String
  date          DateTime  @db.Date
  stake         Decimal   @db.Decimal(10, 2)
  payout        Decimal?  @db.Decimal(10, 2)
  odd           Decimal?  @db.Decimal(10, 3)
  status        BetStatus @default(PENDING)
  resolvedAt    DateTime? @map("resolved_at")
  stakeIsBonus  Boolean   @default(false) @map("stake_is_bonus")
  payoutIsBonus Boolean   @default(false) @map("payout_is_bonus")
  observation   String?
  bookmakerId   String    @map("bookmaker") @db.Uuid
  tipsterId     String?   @map("tipster") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  bookmaker Bookmaker @relation(fields: [bookmakerId], references: [id])
  tipster   Tipster?  @relation(fields: [tipsterId], references: [id])

  @@index([bookmakerId])
  @@index([tipsterId])
  @@index([date])
  @@index([status])
  @@map("bet")
}
